# CPR Reading Library — Environment Variables Template
# Copy this file to .env.local for local development.

# Supabase Credentials (from Supabase Project Settings -> API)
# Get these at https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Base Application URL for QR Code Verification links
# Leave empty to automatically use current window.location.origin (e.g. your Vercel domain or local dev URL)
VITE_APP_URL=""

# Optional Admin Reference Email
ADMIN_DEFAULT_EMAIL="cprmedicalacademy@gmail.com"

